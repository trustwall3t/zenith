generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native","debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String        @id @default(uuid())
  name              String
  phone             String
  address           String
  country           String
  AccountType       String
  email             String        @unique
  password          String
  confirm           String?
  token             String?
  isVerified        Boolean       @default(false)
  isDisabled        Boolean       @default(false)
  refbonus          Int?          @default(0)
  refcode           String?
  refby             String?
  walletBalance     Int?          @default(0)
  ethAddress        String?
  btcAddress        String?
  usdtAddress       String?
  investmentBalance Int?          @default(0)
  profitBalance     Int?          @default(0)
  targetBalance     Int?          @default(0)
  yearlyIncomeRange String?
  zenithId          Int?          @unique
  tradeMode         String        @default("on")
  roiTotal          Int           @default(0)
  sendRoiEmail      Boolean       @default(true)
  sendPlanClosedEmail Boolean     @default(true)
  updatedAt         DateTime      @updatedAt
  createdAt         DateTime      @default(now())
  sessions          Session[]
  transactions      Transaction[]
  kyc               Kyc[]
  copySubscriptions CopySubscription[]
  copyTrades        CopyTrade[]
  userInvestmentPlans UserInvestmentPlan[]
}

/// Site-wide toggles (mirrors Zenith `settings` + active modules).
model SiteSettings {
  id                    String   @id @default("default")
  siteName              String   @default("Apex Trade Zone")
  currency              String   @default("$")
  welcomeMessage        String   @default("")
  enableKyc             Boolean  @default(true)
  enable2fa             Boolean  @default(false)
  enableWithdrawals     Boolean  @default(true)
  googleTranslate       Boolean  @default(false)
  enableCopyTrading     Boolean  @default(true)
  enableSelfTrade       Boolean  @default(true)
  enableInvestmentPlans Boolean  @default(true)
  enableMarketQuotes    Boolean  @default(true)
  tradeMode             Boolean  @default(true)
  weekendTrade          Boolean  @default(true)
  returnCapital         Boolean  @default(true)
  contactEmail          String?
  siteAddress           String?
  logoUrl               String?
  updatedAt             DateTime @updatedAt
}

/// Zenith `plans` table — DB-driven investment tiers (replaces hardcoded arrays).
model InvestmentPlan {
  id                 Int      @id @default(autoincrement())
  name               String
  minPrice           Int
  maxPrice           Int
  incrementAmount    String
  incrementInterval  String
  incrementType      String   @default("Percentage")
  planType           String   @default("Main")
  expiration         String?
  gift               Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userPlans          UserInvestmentPlan[]
}

model UserInvestmentPlan {
  id           String         @id @default(uuid())
  zenithId     Int?           @unique
  userId       String
  planId       Int
  amount       Int
  status       String         @default("yes")
  profitEarned Int            @default(0)
  invDuration  String?
  activatedAt  DateTime?
  expireDate   DateTime?
  lastGrowth   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         InvestmentPlan @relation(fields: [planId], references: [id])
}

model Trader {
  id          Int                @id @default(autoincrement())
  name        String
  description String?
  strategy    String?
  market      String
  winRate     Decimal?           @db.Decimal(5, 2)
  followers   Int                @default(0)
  totalTrades Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  subscriptions CopySubscription[]
  copyTrades  CopyTrade[]
}

model CopyAsset {
  id         Int      @id @default(autoincrement())
  symbol     String   @unique
  name       String
  market     String
  externalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum CopySubscriptionStatus {
  ACTIVE
  PAUSED
  STOPPED
}

model CopySubscription {
  id                   Int                    @id @default(autoincrement())
  userId               String
  traderId             Int
  allocationPercentage Decimal                @db.Decimal(5, 2)
  status               CopySubscriptionStatus @default(ACTIVE)
  startedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trader               Trader                 @relation(fields: [traderId], references: [id], onDelete: Cascade)
  copyTrades           CopyTrade[]

  @@unique([userId, traderId])
}

model CopyTrade {
  id             String            @id @default(uuid())
  userId         String
  traderId       Int?
  subscriptionId Int?
  traderName     String?
  assetSymbol    String
  assetName      String
  market         String
  externalId     String?
  direction      String
  stake          Decimal           @db.Decimal(16, 2)
  entryPrice     Decimal           @db.Decimal(24, 8)
  exitPrice      Decimal?          @db.Decimal(24, 8)
  profit         Decimal?          @db.Decimal(16, 2)
  status         String            @default("open")
  durationSeconds Int
  openedAt       DateTime?
  expiresAt      DateTime?
  closedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trader         Trader?           @relation(fields: [traderId], references: [id], onDelete: SetNull)
  subscription   CopySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([userId, openedAt])
}
model Kyc {
  id        String   @id @default(uuid())
  userId    String
  firstName String
  lastName  String
  phone     String
  address   String
  country   String
  idNumber  String
  idType    String
  idImage   String
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  sessions  AdminSession[]
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id])
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  paymentMethod   String
  transactionId   String   @unique
  status          String
  transactionType String
  postType        String
  amount          Int
  type            String
  pair            String?
  userPlanId      String?
  planName        String?
  createdAt       DateTime @default(now())
  date            DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id          String   @id @default(uuid())
  name        String
  address     String
  description String
  createdAt   DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

